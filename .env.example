# ─── Redact / Citadel — Environment Variables ──────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored — NEVER commit real seed phrases.

# ── Tether WDK — Solana Wallet ───────────────────────────────────────────────
# BIP-39 mnemonic for the operator's Solana wallet.
# Used by /api/anchor to sign on-chain transactions.
# Generate one with: node -e "const WDK = require('@tetherto/wdk').default; console.log(WDK.getRandomSeedPhrase())"
WDK_SEED_PHRASE=

# ── Solana RPC ────────────────────────────────────────────────────────────────
# Default: Solana public devnet (no key needed, but rate-limited).
# For hackathon demo: devnet is sufficient.
# For production: use a dedicated RPC from Helius, QuickNode, or Alchemy.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# ── QVAC SDK ──────────────────────────────────────────────────────────────────
# No keys needed — all inference runs locally via @qvac/sdk.
# Models are auto-downloaded and cached on first use.
# Default cache directory: ~/.cache/qvac/
# Set a custom path if running on a drive with more space:
# QVAC_CACHE_DIR=/data/models/qvac

# ── Secure Drop Upload ───────────────────────────────────────────────────────
# Endpoint that receives ciphertext + envelope for offline transfer.
SECURE_DROP_URL=
# Optional bearer token for your secure drop service.
SECURE_DROP_TOKEN=
# Dev-only: allow upload to be skipped when SECURE_DROP_URL is not set.
ALLOW_UPLOAD_SKIP=false

# ── HQ Public Key (X25519, PEM) ─────────────────────────────────────────────
# Public key used to wrap the bundle key for HQ decryption.
# Example format (single-line env with \n):
# HQ_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
HQ_PUBLIC_KEY_PEM=
# Dev-only: allow auto-generated X25519 public key if HQ key fails parse.
ALLOW_DEV_PUBLIC_KEY=false
